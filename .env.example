# Porta em que o agente escuta — deve bater com o que você expõe no ngrok
# ex: ngrok http 3334  →  BROWSER_AGENT_URL=https://xxxx.ngrok-free.app
BROWSER_AGENT_PORT=3334

# Segredo compartilhado com o teresa-server para autenticar as chamadas.
# Usado em dois sentidos:
# - teresa-server -> teresa-browser-agent
# - teresa-browser-agent -> teresa-server, ao enviar checkpoints de posts curtidos
# Gere com: openssl rand -hex 16
BROWSER_AGENT_SECRET=troque-por-um-segredo-seguro

# URL do teresa-server acessível a partir deste browser-agent.
# Se ambos rodam na mesma máquina, http://127.0.0.1:3333 funciona.
# Se o browser-agent estiver em outra máquina/rede, use a URL pública/túnel do teresa-server.
TERESA_SERVER_URL=http://127.0.0.1:3333

# false = mostra o browser na tela (útil para debug)
PLAYWRIGHT_HEADLESS=true

# ─── DEPENDÊNCIAS DO HOST ─────────────────────────────────────────────────────
# Para baixar áudio de posts e enviar ao Whisper, instale no host do browser-agent:
# Ubuntu/Debian:
#   sudo apt-get update && sudo apt-get install -y ffmpeg python3-pip
#   python3 -m pip install -U yt-dlp
# Docker Debian/Ubuntu:
#   RUN apt-get update \
#     && apt-get install -y --no-install-recommends ffmpeg python3-pip \
#     && python3 -m pip install -U yt-dlp \
#     && rm -rf /var/lib/apt/lists/*

# ─── TIKTOK — LOGIN QR ─────────────────────────────────────────────────────────
# Timeouts (em ms) — valores padrão recomendados

TIKTOK_QR_READY_TIMEOUT_MS=20000
TIKTOK_QR_LOGIN_TIMEOUT_MS=120000
TIKTOK_LOGIN_SESSION_TIMEOUT_MS=300000

# ─── TIKTOK — COLETA DE POSTS CURTIDOS ────────────────────────────────────────
# Controla o comportamento do scraper Playwright

TIKTOK_WEB_MAX_VIDEOS=10
TIKTOK_WEB_HOVER_MIN_MS=800
TIKTOK_WEB_HOVER_MAX_MS=2500
TIKTOK_WEB_SCROLL_DELAY_MIN_MS=2000
TIKTOK_WEB_SCROLL_DELAY_MAX_MS=5000
