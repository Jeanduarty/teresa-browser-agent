# Porta em que o agente escuta — deve bater com o que você expõe no ngrok
# ex: ngrok http 3334  →  BROWSER_AGENT_URL=https://xxxx.ngrok-free.app
BROWSER_AGENT_PORT=3334

# Segredo compartilhado com o Render para autenticar as chamadas.
# Gere com: openssl rand -hex 16
BROWSER_AGENT_SECRET=troque-por-um-segredo-seguro

# false = mostra o browser na tela (útil para debug)
PLAYWRIGHT_HEADLESS=true

# Timeouts (em ms) — valores padrão recomendados
TIKTOK_QR_READY_TIMEOUT_MS=20000
TIKTOK_QR_LOGIN_TIMEOUT_MS=120000
TIKTOK_LOGIN_SESSION_TIMEOUT_MS=300000
